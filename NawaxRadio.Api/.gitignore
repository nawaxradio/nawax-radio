# =====================================================
# Nawax Radio - .gitignore (Clean & Safe)
# .NET + Flutter + Firebase
# =====================================================

# ===== OS / IDE =====
.DS_Store
Thumbs.db
.vscode/
.idea/
.vs/
*.iml
*.user
*.suo

# ===== Logs / Caches =====
*.log
*.cache

# ===== .NET build outputs =====
bin/
obj/
out/
**/bin/
**/obj/
**/out/

# ===== appsettings (secrets only) =====
appsettings.Development.json
appsettings.Production.json

# ===== Secrets / Keys / Certs =====
*firebase-adminsdk*.json
*.pfx
*.pem
*.key
*.crt
*.bak
.env
.env.*

# ===== Firebase (allow public configs) =====
!firebase.json
!.firebaserc

# ===== Local / Temp =====
uploads/
test.mp3
channels_out.json
liara.json

# ===== Flutter / Dart =====
.dart_tool/
.packages
.pub/
build/
.metadata
.flutter-plugins
.flutter-plugins-dependencies
**/.dart_tool/
**/.packages
**/.pub/
**/build/
**/.metadata
**/.flutter-plugins
**/.flutter-plugins-dependencies

# ===== Android =====
**/android/.gradle/
**/android/local.properties
**/android/app/debug.keystore
**/*.keystore
**/*.jks

# ===== iOS =====
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
